# ============================================================================
# APPLICATION CORE CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB URI - Complete connection string (required)
MONGODB_URI=mongodb://cervitech_user:your_secure_password_here@mongodb:27017/cervitech?authSource=admin

# Docker MongoDB Credentials
MONGO_ROOT_USERNAME=cervitech_user
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGO_PORT=27017

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ============================================================================
# JWT & AUTHENTICATION SECRETS (required)
# ============================================================================
JWT_SECRET=your_jwt_secret_key_here
APP_USER_JWT_SECRET=appuser-secret-key-here
BACKOFFICE_JWT_SECRET=backoffice-secret-key-here
GENERAL_TOKEN_SECRET=general-secret-key-here

# ============================================================================
# FCM (Firebase Cloud Messaging) - Push Notifications (required)
# ============================================================================
FCM_SERVER_KEY=your_fcm_server_key_here

# ============================================================================
# EMAIL SERVICE CONFIGURATION (required)
# ============================================================================
# Azure Communication Services
ACS_CONNECTION_STRING=your_azure_communication_services_connection_string
SENDER_EMAIL=noreply@cervitech.com

# ============================================================================
# URL CONFIGURATION (required)
# ============================================================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ============================================================================
# ENVIRONMENT COLORS (for logging/UI indicators)
# ============================================================================
ENV_COLOR_GREEN=#22c55e
ENV_COLOR_BLUE=#3b82f6
ENV_COLOR_YELLOW=#eab308
ENV_COLOR_ORANGE=#f97316
ENV_COLOR_RED=#ef4444

# ============================================================================
# GOOGLE PLAY BILLING - Server-side purchase verification (#08/#09)
# ============================================================================
# JSON key for a Google Cloud service account granted Finance/Orders access
# in Play Console. Required to verify POST /transaction purchase tokens and
# to run the daily subscription-sync job. Leave unset and both are skipped
# (legacy client-submitted-status path still works; sync job logs a warning
# and no-ops).
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
# Android package name the subscriptions belong to, e.g. com.cervitech.app
GOOGLE_PLAY_PACKAGE_NAME=

# ============================================================================
# MONTHLY RE-ENGAGEMENT EMAIL JOB
# ============================================================================
# Cron schedule (UTC) for the "We Miss You" inactivity reminder email.
# Default: 14th of every month at 09:00 UTC.
REMINDER_CRON_SCHEDULE=0 9 14 * *
# Set to false to disable the job entirely (e.g. local dev against a shared DB).
REMINDER_JOB_ENABLED=true

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Number of neck angle records before sending average
ENV_NUMBER_OF_RECORD_POST_BEFORE_SENDING_AVERAGE_NECK_ANGLE=10
